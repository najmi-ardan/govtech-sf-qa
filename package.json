{
  "name": "govtech-sf-qa",
  "version": "1.0.0",
  "private": true,
  "description": "Playwright and TypeScript tests for Salesforce Lightning.",
  "scripts": {
    "test": "playwright test",
    "test:smoke": "playwright test --grep @smoke",
    "test:chromium": "playwright test --project=chromium",
    "test:webkit": "playwright test --project=webkit",
    "test:headed": "playwright test --project=chromium --headed",
    "test:list": "playwright test --list",
    "session:check": "playwright test --project=setup",
    "cleanup:test-data": "tsx scripts/cleanup-test-data.ts",
    "report": "playwright show-report reports/html",
    "typecheck": "tsc --noEmit",
    "lint": "eslint . --max-warnings 0",
    "lint:fix": "eslint . --fix",
    "check": "npm run typecheck && npm run lint"
  },
  "engines": {
    "node": ">=20.19"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@faker-js/faker": "^10.6.0",
    "@playwright/test": "^1.64.0",
    "@types/node": "^20.19.43",
    "dotenv": "^18.0.6",
    "eslint": "^9.39.5",
    "eslint-plugin-playwright": "^2.12.1",
    "tsx": "^4.23.15",
    "typescript": "~5.9",
    "typescript-eslint": "^8.71.1"
  }
}
