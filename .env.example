# Copy to .env. .env is gitignored.
#
# The suite reuses a Playwright storageState file.
# When Salesforce rejects it, the JWT settings below ask for a new browser session.
# Leave them empty to keep the saved file only. A partial set is an error.

STORAGE_STATE_PATH=storage/storageState.json

# Existing Salesforce username, External Client App consumer key, and the private key.
# SF_JWT_PRIVATE_KEY is the PEM, with newlines written as \n. Use one of the two key settings.
# The local key file is .certs/jwt-private.pem. Leave every line empty until the app exists.
SF_USERNAME=
SF_CLIENT_ID=
SF_JWT_KEY_PATH=
SF_JWT_PRIVATE_KEY=
# Token audience. Empty uses https://login.salesforce.com.
SF_LOGIN_URL=

# Lightning origin. Leave empty to read it from the session file.
# A pasted page URL is reduced to its origin.
SF_BASE_URL=

# REST version for seeding an Account or Contact, read-back, and cleanup.
SF_API_VERSION=v62.0

# Timeouts in milliseconds.
ACTION_TIMEOUT=20000
EXPECT_TIMEOUT=20000
NAVIGATION_TIMEOUT=60000
TEST_TIMEOUT=180000

# Parallel workers. Unset uses 2.
WORKERS=
LOG_LEVEL=info

# true deletes records the tests tracked, through REST, at teardown.
CLEANUP_TEST_DATA=false

# Stage the org assigns to a converted Opportunity.
OPP_DEFAULT_STAGE=Prospecting
